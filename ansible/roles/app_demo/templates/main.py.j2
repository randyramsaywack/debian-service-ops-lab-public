import os

from fastapi import FastAPI


app = FastAPI(title="Debian Service Operations Lab API")


@app.get("/api/healthz")
def healthz() -> dict[str, str]:
    return {"status": "ok"}


@app.get("/api/message")
def message() -> dict[str, str]:
    return {"message": os.environ.get("OPS_LAB_MESSAGE", "Hello from ops-dev")}
