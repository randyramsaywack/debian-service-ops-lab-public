<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ nginx_demo_document_title }}</title>
    <style>
      :root {
        color-scheme: light;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: linear-gradient(160deg, #f3f6f8 0%, #d9e3ea 100%);
        color: #13212b;
      }

      main {
        max-width: 42rem;
        margin: 2rem;
        padding: 2rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 20px 50px rgba(19, 33, 43, 0.12);
      }

      h1 {
        margin-top: 0;
      }

      code {
        padding: 0.15rem 0.4rem;
        border-radius: 0.35rem;
        background: #e8eef2;
      }

      button {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border: 0;
        border-radius: 0.6rem;
        background: #13212b;
        color: #f8fbfd;
        cursor: pointer;
      }

      .status[data-state="ok"] {
        color: #0b6b38;
      }

      .status[data-state="error"] {
        color: #8e1b1b;
      }

      pre {
        min-height: 3rem;
        padding: 1rem;
        border-radius: 0.6rem;
        background: #e8eef2;
        white-space: pre-wrap;
      }
    </style>
  </head>
  <body>
    <main>
      <p><strong>{{ inventory_hostname }}</strong></p>
      <h1>{{ nginx_demo_body_heading }}</h1>
      <p>{{ nginx_demo_body_text }}</p>
      <p>Validation target: <code>http://{{ ansible_default_ipv4.address }}{{ nginx_demo_health_path }}</code></p>
      <p class="status" id="api-status">API status: checking</p>
      <button id="load-message" type="button">Load API Message</button>
      <pre id="api-message">Click the button to fetch /api/message.</pre>
    </main>
    <script src="/app.js"></script>
  </body>
</html>
